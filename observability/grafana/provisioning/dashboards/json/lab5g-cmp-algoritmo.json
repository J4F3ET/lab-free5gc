     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "query_result(lab5g_cmp_eval_clase_info)",
     "refId": "v"
    },
    "definition": "query_result(lab5g_cmp_eval_clase_info)",
