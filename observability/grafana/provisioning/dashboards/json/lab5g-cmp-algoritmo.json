    },
    "definition": "query_result(lab5g_cmp_eval_algoritmo_info)",
    "regex": "/algoritmo=\"(?<value>[^\"]+)\".*texto=\"(?<text>[^\"]+)\"/",
    "refresh": 2,
    "sort": 1,
    "multi": false,
    "includeAll": false,
    "current": {
     "selected": true,
