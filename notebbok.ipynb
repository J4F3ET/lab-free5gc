# ==========================================
# SIMULACIÓN 4G TRADICIONAL
# ==========================================

def simulate_4G(rng):

    queues, delays = reset_environment()

    generated_total = 0
    delivered_total = 0
    latency_total = 0
    lost_total = 0


    for step in range(
        SIMULATION_SLOTS
    ):

        (
            queues,
            delays,
            reward,
            generated,
            delivered,
            latency,
            lost
        ) = environment_step(

            queues,
            delays,
            rng,

            # 4G utiliza una estrategia fija
            # sin Reinforcement Learning
            action=0,

            # Capacidad limitada
            capacity=CAPACITY_4G
        )


        generated_total += generated
        delivered_total += delivered
        latency_total += latency
        lost_total += lost


    return (
        generated_total,
        delivered_total,
        latency_total,
        lost_total
    )

# ==========================================
# SIMULACIÓN 5G + REINFORCEMENT LEARNING
# ==========================================

def simulate_5G_RL(rng):

    queues, delays = reset_environment()

    generated_total = 0
    delivered_total = 0
    latency_total = 0
    lost_total = 0


    for step in range(
        SIMULATION_SLOTS
    ):


        # -------------------------------
        # ESTADO ACTUAL
        # -------------------------------

        state = get_state(
            queues,
            delays
        )


        # -------------------------------
        # EL AGENTE TOMA LA DECISIÓN
        # -------------------------------

        action = agent.choose_action(
            state,
            training=False
        )


        # -------------------------------
        # EJECUTAR DECISIÓN
        # -------------------------------

        (
            queues,
            delays,
            reward,
            generated,
            delivered,
            latency,
            lost
        ) = environment_step(

            queues,
            delays,
            rng,
            action,

            # Mayor capacidad de 5G
            capacity=CAPACITY_5G
        )


        generated_total += generated
        delivered_total += delivered
        latency_total += latency
        lost_total += lost


    return (
        generated_total,
        delivered_total,
        latency_total,
        lost_total
    )

# ==========================================
# PRUEBAS COMPARATIVAS
# ==========================================

NUM_TESTS = 3000

results_4G = []
results_5G_RL = []


for test in range(NUM_TESTS):

    # Misma semilla para ambas redes
    rng_4G = np.random.default_rng(test)
    rng_5G = np.random.default_rng(test)


    # Simular 4G
    result_4G = simulate_4G(
        rng_4G
    )


    # Simular 5G + RL
    result_5G = simulate_5G_RL(
        rng_5G
    )


    results_4G.append(
        result_4G
    )

    results_5G_RL.append(
        result_5G


    )

print("Pruebas terminadas:", NUM_TESTS)

# ==========================================
# CONVERTIR RESULTADOS
# ==========================================

results_4G = np.array(
    results_4G
)

results_5G_RL = np.array(
    results_5G_RL
)


# ==========================================
# PROMEDIOS
# ==========================================

generated_4G = np.mean(
    results_4G[:, 0]
)

generated_5G = np.mean(
    results_5G_RL[:, 0]
)


delivered_4G = np.mean(
    results_4G[:, 1]
)

delivered_5G = np.mean(
    results_5G_RL[:, 1]
)


lost_4G = np.mean(
    results_4G[:, 3]
)

lost_5G = np.mean(
    results_5G_RL[:, 3]
)


# ==========================================
# LATENCIA PROMEDIO
# ==========================================

latency_4G = (
    results_4G[:, 2].sum()
    /
    max(results_4G[:, 1].sum(), 1)
)


latency_5G = (
    results_5G_RL[:, 2].sum()
    /
    max(results_5G_RL[:, 1].sum(), 1)
)


# ==========================================
# RELIABILITY
# ==========================================

reliability_4G = (
    delivered_4G
    /
    max(generated_4G, 1)
)


reliability_5G = (
    delivered_5G
    /
    max(generated_5G, 1)
)


print("==========================================")
print("          COMPARACIÓN FINAL")
print("==========================================")

print()

