# Sistema Inteligente de Comunicaciones 5G + Reinforcement Learning

## Caso de estudio: Ambulancia inteligente

Se compara una red 4G tradicional con una red 5G apoyada
por Reinforcement Learning para priorizar paquetes críticos.

El objetivo es demostrar que el aprendizaje del agente permite
tomar mejores decisiones de asignación de recursos para tráfico
de emergencia.

import numpy as np
import matplotlib.pyplot as plt

from collections import defaultdict

print("Librerías cargadas correctamente")

# ==========================================
# PARÁMETROS GENERALES
# ==========================================

NUM_USERS = 10

# Duración de cada simulación
SIMULATION_SLOTS = 20

# Probabilidad de llegada de un paquete
ARRIVAL_PROB = 0.30

# Tamaño máximo de una cola
MAX_QUEUE = 5

# Límite máximo de espera para considerar
# que un paquete incumplió URLLC
URLLC_DEADLINE = 4


# ==========================================
# CAPACIDAD DE LAS REDES
# ==========================================

# 4G puede atender 1 paquete por instante
CAPACITY_4G = 1

# 5G puede atender 2 paquetes por instante
CAPACITY_5G = 2


# ==========================================
# PARÁMETROS DEL REINFORCEMENT LEARNING
# ==========================================

ALPHA = 0.15

# Importancia de las recompensas futuras
GAMMA = 0.90

# Exploración inicial
EPSILON_START = 1.0

# Exploración mínima
EPSILON_MIN = 0.05

# Reducción progresiva de epsilon
EPSILON_DECAY = 0.9995


print("Parámetros configurados")
print("Usuarios:", NUM_USERS)
print("Capacidad 4G:", CAPACITY_4G)
print("Capacidad 5G:", CAPACITY_5G)

# ==========================================
# AGENTE DE REINFORCEMENT LEARNING
# ==========================================

class QLearningAgent:

    def __init__(
        self,
        alpha=ALPHA,
        gamma=GAMMA,
        epsilon=EPSILON_START
    ):

        # Tasa de aprendizaje
        self.alpha = alpha

        # Importancia de las recompensas futuras
        self.gamma = gamma

        # Nivel de exploración
        self.epsilon = epsilon

        # Tabla Q
        #
        # Cada estado tendrá 3 posibles acciones
        self.q_table = defaultdict(
            lambda: np.zeros(3)
        )


    def choose_action(self, state, training=True):

        # EXPLOTACIÓN / EXPLORACIÓN
        if training and np.random.rand() < self.epsilon:

            # Explorar:
            # escoger una acción aleatoria
            return np.random.randint(3)

        else:

            # Explotar:
            # escoger la acción con mayor valor Q
            return int(
                np.argmax(self.q_table[state])
            )


    def learn(self, state, action, reward, next_state):

        # Valor Q actual
        current_q = self.q_table[state][action]

        # Mejor recompensa futura
        best_future_q = np.max(
            self.q_table[next_state]
        )

        # Fórmula Q-Learning
        new_q = current_q + self.alpha * (
            reward
            + self.gamma * best_future_q
            - current_q
        )

        # Actualizar tabla Q
        self.q_table[state][action] = new_q


    def decay_epsilon(self):

        # Reducir exploración progresivamente
        self.epsilon = max(
            EPSILON_MIN,
            self.epsilon * EPSILON_DECAY
        )


# ==========================================
# CREACIÓN DEL AGENTE
# ==========================================

agent = QLearningAgent()

print("AGENTE CREADO")
print("-----------------------------")
print("Alpha:", agent.alpha)
print("Gamma:", agent.gamma)
print("Epsilon inicial:", agent.epsilon)
print("Acciones posibles:", 3)

# ==========================================
# CONSTRUCCIÓN DEL ESTADO
# ==========================================

def get_state(queues, delays):

    # Cantidad total de paquetes esperando
    total_packets = min(
        int(queues.sum()) // 3,
        6
    )

    # Cantidad de usuarios con paquetes
    # que ya llevan una espera importante
    urgent_users = min(
        int(np.sum(delays >= 2)),
        5
    )

    # Mayor latencia actual
    max_delay = min(
        int(delays.max()),
        URLLC_DEADLINE
    )

    # Estado que observará el agente
    state = (
        total_packets,
        urgent_users,
        max_delay
    )

    return state


print("Función de estado creada")

# ==========================================
# ACCIONES DEL AGENTE
# ==========================================

def select_users(queues, delays, action, capacity):

    # Usuarios que tienen paquetes esperando
    available_users = np.flatnonzero(
        queues > 0
    )

    if len(available_users) == 0:
        return []


    # --------------------------------------
    # ACCIÓN 0
    # Priorizar paquetes más antiguos
    # --------------------------------------

    if action == 0:

        key_function = lambda user: (
            delays[user],
            queues[user]
        )


    # --------------------------------------
    # ACCIÓN 1
    # Priorizar las colas más grandes
    # --------------------------------------

    elif action == 1:

        key_function = lambda user: (
            queues[user],
            delays[user]
        )


    # --------------------------------------
    # ACCIÓN 2
    # Estrategia equilibrada
    # --------------------------------------

    else:

        key_function = lambda user: (
            2 * delays[user] + queues[user],
            delays[user],
            queues[user]
        )


    # Ordenar usuarios según la estrategia
    selected_users = sorted(
        available_users,
        key=key_function,
        reverse=True
    )

    # Seleccionar solamente los usuarios
    # que podemos atender
    return selected_users[:capacity]

# ==========================================
# REINICIAR EL ENTORNO
# ==========================================

def reset_environment():

    # Cola de paquetes de cada usuario
    queues = np.zeros(
        NUM_USERS,
        dtype=int
    )

    # Tiempo que lleva esperando
    # cada usuario
    delays = np.zeros(
        NUM_USERS,
        dtype=int
    )

    return queues, delays

# ==========================================
# PASO DEL ENTORNO
# ==========================================

def environment_step(
    queues,
    delays,
    rng,
    action,
    capacity
):

    queues = queues.copy()
    delays = delays.copy()


    # ======================================
    # 1. LLEGADA DE NUEVOS PAQUETES
    # ======================================

    arrivals = (
        rng.random(NUM_USERS)
        < ARRIVAL_PROB
    ).astype(int)

    # Paquetes que intentan entrar
    generated_packets = int(
        arrivals.sum()
    )


    # ======================================
    # 2. CONTROL DE COLA
    # ======================================

    overflow = np.maximum(
        queues + arrivals - MAX_QUEUE,
        0
    )

    overflow_lost = int(
        overflow.sum()
    )

    queues = np.minimum(
        queues + arrivals,
        MAX_QUEUE
    )


    # ======================================
    # 3. AUMENTAR TIEMPO DE ESPERA
    # ======================================

    delays = np.where(
        queues > 0,
        delays + 1,
        0
    )


    # ======================================
    # 4. EL AGENTE DECIDE A QUIÉN ATENDER
    # ======================================

    selected_users = select_users(
        queues,
        delays,
        action,
        capacity
    )


    # ======================================
    # 5. ENTREGAR PAQUETES
    # ======================================

    delivered = 0
    total_latency = 0
    urgent_delivered = 0

    for user in selected_users:

        if queues[user] > 0:

            delivered += 1

            total_latency += int(
                delays[user]
            )

            # Paquete considerado urgente
            if delays[user] >= 2:
                urgent_delivered += 1

            # Entregar paquete
            queues[user] -= 1

            # Reiniciar su espera
            delays[user] = 0


    # ======================================
    # 6. DETECTAR PAQUETES QUE INCUMPLEN
    #    EL REQUISITO URLLC
    # ======================================

    expired = (
        (queues > 0)
        &
        (delays >= URLLC_DEADLINE)
    )

    deadline_lost = int(
        queues[expired].sum()
    )

    queues[expired] = 0
    delays[expired] = 0


    # ======================================
    # 7. TOTAL DE PAQUETES PERDIDOS
    # ======================================

    lost_packets = (
        overflow_lost
        + deadline_lost
    )


    # ======================================
    # 8. RECOMPENSA
    # ======================================

    reward = (

        # Premiar paquetes entregados
        15 * delivered

        # Penalizar latencia
        - 2 * total_latency

        # Premiar atención de paquetes urgentes
        + 8 * urgent_delivered

        # Penalizar pérdidas
        - 25 * lost_packets
    )


    # Penalizar recursos desperdiciados
    if len(selected_users) < capacity:

        reward -= 2 * (
            capacity - len(selected_users)
        )


    return (
        queues,
        delays,
        reward,
        generated_packets,
        delivered,
        total_latency,
        lost_packets
    )

# ==========================================
# ENTRENAMIENTO DEL AGENTE
# ==========================================

EPISODES = 10000

rewards_history = []
epsilon_history = []


for episode in range(EPISODES):

    # Crear un nuevo escenario
    queues, delays = reset_environment()

    # Generador de tráfico
    rng = np.random.default_rng(
        episode + 12345
    )

    total_reward = 0


    # Simular 20 instantes
    for step in range(SIMULATION_SLOTS):


        # ----------------------------------
        # 1. EL AGENTE OBSERVA
        # ----------------------------------

        state = get_state(
            queues,
            delays
        )


        # ----------------------------------
        # 2. EL AGENTE DECIDE
        # ----------------------------------

        action = agent.choose_action(
            state,
            training=True
        )


        # ----------------------------------
        # 3. EL ENTORNO RESPONDE
        # ----------------------------------

        (
            new_queues,
            new_delays,
            reward,
            generated,
            delivered,
            latency,
            lost
        ) = environment_step(

            queues,
            delays,
            rng,
            action,
            CAPACITY_5G
        )


        # ----------------------------------
        # 4. OBTENER NUEVO ESTADO
        # ----------------------------------

        new_state = get_state(
            new_queues,
            new_delays
        )


        # ----------------------------------
        # 5. EL AGENTE APRENDE
        # ----------------------------------

        agent.learn(
            state,
            action,
            reward,
            new_state
        )


        # Actualizar entorno
        queues = new_queues
        delays = new_delays


        # Acumular recompensa
        total_reward += reward


    # Guardar información
    rewards_history.append(
        total_reward
    )

    epsilon_history.append(
        agent.epsilon
    )


    # Reducir exploración
    agent.decay_epsilon()


print("====================================")
print("ENTRENAMIENTO FINALIZADO")
print("====================================")

print("Episodios:", EPISODES)
print("Epsilon final:", agent.epsilon)
print("Estados aprendidos:", len(agent.q_table))

# ==========================================
# PROMEDIO MÓVIL DE RECOMPENSA
# ==========================================

window = 200

moving_average = np.convolve(
    rewards_history,
    np.ones(window) / window,
    mode="valid"
)


plt.figure(figsize=(10, 5))

plt.plot(
    moving_average,
    linewidth=2
)

plt.xlabel("Episodio")
plt.ylabel("Recompensa promedio")

plt.title(
    "Aprendizaje del agente 5G + Reinforcement Learning"
)

plt.grid()

plt.show()

# ==========================================
# EVOLUCIÓN DE EPSILON
# ==========================================

plt.figure(figsize=(10, 5))

plt.plot(
    epsilon_history
)

plt.xlabel("Episodio")
plt.ylabel("Epsilon")

plt.title(
    "Reducción de la exploración del agente"
)

plt.grid()

plt.show()
