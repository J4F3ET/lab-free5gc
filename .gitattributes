# Todo lo que se ejecuta o se instala en Linux va SIEMPRE con LF, sea cual sea el
# autocrlf del equipo donde se edite (un CRLF rompe el shebang y los units de systemd).
*.sh                         text eol=lf
*.service                    text eol=lf
*.timer                      text eol=lf
*.yml                        text eol=lf
*.yaml                       text eol=lf
deploy/sudoers-*             text eol=lf

# Textos congelados del tráfico de prueba de compresion/: sus bytes (CRLF incluido) definen
# los resultados, así que git no debe convertirlos.
compresion/textos/** -text
