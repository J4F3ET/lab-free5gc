# ⚠️ Verifica que estos tags existan antes de desplegar.
FREE5GC_TAG=v3.4.4
UERANSIM_TAG=latest
MONGO_TAG=6.0

# PLMN
MCC=732
MNC=101
IMSI=732101000000001

# --- Direccionamiento interno (redes Docker dentro del LXC) ---
SBI_SUBNET=10.100.200.0/24
N3_SUBNET=10.100.201.0/24
RADIO_SUBNET=10.100.203.0/24
DN_SUBNET=10.100.204.0/24
OBS_SUBNET=10.100.205.0/24
UE_POOL=10.60.0.0/16

# --- LAN (acceso directo, sin Tailscale) ---
LAN_SUBNET=192.168.1.0/24
LAN_GW=192.168.1.1
LXC_IP=192.168.1.50          # IP fija del LXC del lab; publica 3000/5000/9090

# --- MTU ---
# Sin Tailscale el path MTU de la LAN es 1500 completo.
# UE_MTU = DOCKER_MTU - 36 bytes de cabecera GTP-U.
DOCKER_MTU=1500
UE_MTU=1464

GRAFANA_ADMIN_PASSWORD=cambiame
